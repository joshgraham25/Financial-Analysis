# Derived voiceover cuts -- regenerate with make_voiceover.py
two-minute-training-tuesday/episodes/*/TMTT-*-voiced*.mp4
two-minute-training-tuesday/episodes/*/TMTT-*-narration.m4a

# Office lock files -- present only while a workbook is open in Excel
~$*

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Raw screen recordings and intermediates from the overlay pipeline. The raw
# captures are tens of MB and live in Downloads/OneDrive already; the retimed
# intermediate and the check stills are both regenerable from them.
two-minute-training-tuesday/episodes/*/raw-*.webm
two-minute-training-tuesday/episodes/*/raw-*.mp4
two-minute-training-tuesday/episodes/*/Video Project*.mp4
two-minute-training-tuesday/episodes/*/overlay-check/

# Files staged for a manual SharePoint upload -- copies, not sources.
two-minute-training-tuesday/distribution/_upload/

# Real ERP exports dropped for the purchasing review. Live part numbers, balances
# and supplier pricing -- the sample data in purchasing/sample-data/ is the only
# input set that belongs in the repo. Generated packets under reviews/ do belong:
# week over week they are the record of what was known and when.
purchasing/exports/

# Python bytecode
__pycache__/
*.pyc
